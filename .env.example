# OpenAI API key used by every LLM-backed agent node
OPENAI_API_KEY=sk-...

# Path to the OAuth client file you download from Google Cloud Console
# (APIs & Services > Credentials > Create Credentials > OAuth client ID > Desktop app)
GOOGLE_OAUTH_CLIENT_SECRETS=./credentials/client_secret.json

# Where the user's Gmail/Calendar OAuth token is cached after the first
# consent flow, so you don't have to re-authenticate every run
GOOGLE_OAUTH_TOKEN_PATH=./credentials/token.json

# Comma-separated list of sender domains/addresses that count as
# "school correspondence" for the School Agent's Gmail query
SCHOOL_SENDER_ALLOWLIST=schoolapp.example.com,frontdesk@ourschool.edu

# Which Google Calendar to write events into (use "primary" for the
# account's main calendar, or a specific calendar ID)
TARGET_CALENDAR_ID=primary

# ChildOps run mode: "demo" replays data/sample_emails.json through the
# graph with no network calls to Google; "live" polls real Gmail/Calendar
CHILDOPS_MODE=demo

# --- testing/send_test_email.py only (not used by ChildOps itself) ---
# A throwaway Gmail account that plays "the school" and sends real test
# emails into your fake parent account. Needs 2-Step Verification turned on
# and an App Password generated for it (myaccount.google.com/apppasswords)
# — NOT your regular Google password. See README > "Testing against a real
# fake Gmail inbox".
TEST_SENDER_EMAIL=throwaway.tester@gmail.com
TEST_SENDER_APP_PASSWORD=xxxx xxxx xxxx xxxx

# The fake "parent" Gmail account ChildOps itself reads from in live mode —
# same account you did the OAuth setup against.
TEST_RECIPIENT_EMAIL=fake.parent.account@gmail.com
